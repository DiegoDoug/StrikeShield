# Copy to .env and customize before running against anything but a
# throwaway local Postgres. docker-compose.yml reads these automatically.
# Never commit the real .env file (it's already in .gitignore).

STRIKESHIELD_JWT_KEY=change-me-to-a-random-32-plus-character-secret
STRIKESHIELD_SEED_ADMIN_EMAIL=admin@strikeshield.local
STRIKESHIELD_SEED_ADMIN_PASSWORD=change-me-before-anything-but-local-dev

# Host-side port overrides — change any of these if the default is already
# in use on your machine (common for 8085/5432/6379).
STRIKESHIELD_API_PORT=8085
STRIKESHIELD_POSTGRES_PORT=5432
STRIKESHIELD_REDIS_PORT=6379
STRIKESHIELD_JUICE_SHOP_PORT=3000
STRIKESHIELD_FRONTEND_PORT=8080

# Extra browser origins allowed to call the Api directly (docs/PHASED_PLAN.md
# Phase 9) — the compose frontend service is same-origin through its own
# nginx proxy already, so this normally only matters for `npm run dev`
# (Vite on 5173) or a frontend served from a non-default port.
STRIKESHIELD_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# BYOK for the "strix" playbook step (docs/PHASED_PLAN.md Phase 4) — your
# own LLM API key, billed to your own account. Leave blank to skip Strix
# scans entirely; every other tool works without this.
STRIKESHIELD_STRIX_LLM_MODEL=anthropic/claude-sonnet-4-6
STRIKESHIELD_STRIX_LLM_API_KEY=

# BYOK for the Correlator's LLM-escalation pass, the Adaptive Planner
# (docs/PHASED_PLAN.md Phase 6), and the Reporting Agent (Phase 7) — a
# separate key/model from Strix's above, since these call Anthropic's
# Messages API directly. Leave blank to skip all three; the deterministic
# Correlator pass and every other tool still work without this.
STRIKESHIELD_AI_LLM_MODEL=claude-sonnet-4-6
STRIKESHIELD_AI_LLM_API_KEY=
