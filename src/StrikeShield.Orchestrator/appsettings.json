{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=strikeshield;Username=strikeshield;Password=strikeshield"
  },
  "Docker": {
    "Host": "unix:///var/run/docker.sock"
  },
  "Orchestrator": {
    "NetworkName": "strikeshield-net",
    "ScanOutputVolumeName": "strikeshield-scan-output",
    "ScanOutputMountPath": "/scan-output",
    "PollIntervalSeconds": 5
  }
}
