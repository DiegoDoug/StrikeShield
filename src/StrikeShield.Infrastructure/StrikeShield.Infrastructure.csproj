<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed as a plain class library (Sdk, not Sdk.Web) for
         Microsoft.Extensions.Diagnostics.HealthChecks types (IHealthCheck,
         HealthCheckResult, AddHealthChecks/AddCheck), which ship in the
         ASP.NET Core shared framework rather than as standalone packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrikeShield.Domain\StrikeShield.Domain.csproj" />
    <ProjectReference Include="..\StrikeShield.Application\StrikeShield.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- AddHttpClient<TClient, TImplementation>() for AnthropicLlmClient
         (docs/PHASED_PLAN.md Phase 6) — explicit reference rather than
         relying on it being present in the Microsoft.AspNetCore.App shared
         framework above. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <!-- Markdown -> HTML -> PDF render pipeline (docs/PHASED_PLAN.md Phase
         7): Markdig converts the Reporting Agent's Markdown to HTML;
         Microsoft.Playwright drives headless Chromium's print-to-PDF.
         Requires a matching Playwright browser install in the Api image's
         runtime stage — see src/StrikeShield.Api/Dockerfile. -->
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.47.0" />
    <!-- IRecurringJobManager/AddOrUpdate for HangfireScanScheduleRegistrar
         (docs/PHASED_PLAN.md Phase 8) — the actual Hangfire server/storage/
         dashboard wiring lives in StrikeShield.Api (Hangfire.AspNetCore,
         Hangfire.PostgreSql), the only process that needs to run it. -->
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
  </ItemGroup>

</Project>
